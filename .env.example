# ==============================================================================
# VIETNAM STOCK ANALYZER - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# ==============================================================================

# 1. CẤU HÌNH NHÀ CUNG CẤP AI (AI PROVIDER)
# Các lựa chọn hợp lệ: 'gemini', 'openai', 'claude', 'ollama', 'offline'
# Nếu chọn 'offline' hoặc chưa có API key, hệ thống sẽ sử dụng Rule-Based Engine độc lập.
LLM_PROVIDER=offline

# 2. API KEYS CHO CÁC MÔ HÌNH AI
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 3. CẢNH BÁO TỨC THÌ QUA TELEGRAM BOT (Tùy chọn)
# Lấy Bot Token từ @BotFather, Chat ID từ @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# 4. TÙY CHỌN KẾT NỐI NGUỒN DỮ LIỆU FIREANT (Tùy chọn)
# Nhập Bearer Token lấy từ Header Authorization khi đăng nhập web/app FireAnt
FIREANT_BEARER_TOKEN=

# 5. DANH SÁCH MÃ QUÉT MẶC ĐỊNH CHO CHẾ ĐỘ SCAN
# Danh sách các mã đầu ngành có thanh khoản cao
DEFAULT_WATCHLIST=HPG,FPT,VCB,MBB,TCB,MWG,VHM,VIC,VNM,MSN,SSI,VND,DGC,VHC,PVD,GAS,STB,ACB,KDH,REE
